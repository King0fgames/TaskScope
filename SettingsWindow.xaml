<Window x:Class="TaskScope.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskScope settings" Width="600" Height="560" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <DockPanel Margin="18,14,18,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="Save_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Low-memory warning" FontWeight="SemiBold" FontSize="14" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Warn me when free commit drops below" VerticalAlignment="Center" />
                <TextBox x:Name="CommitBox" Width="70" Margin="10,0,6,0" />
                <TextBlock Text="GB" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="CommitHint" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="Update speed" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0" />
            <ComboBox x:Name="IntervalBox" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0" />

            <TextBlock Text="Memory watches" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="When any process with this name uses more memory than its limit, TaskScope tells you, and can also pause (suspend) or end it. Pausing keeps its work: right-click it and choose Resume when you have room." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add watch" Click="Add_Click" />
            <Button Content="Remove" Click="Remove_Click" Margin="8,0,0,0" />
        </StackPanel>

        <DataGrid x:Name="WatchGrid" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process name (e.g. java.exe)" Binding="{Binding Image}" Width="*" />
                <DataGridTextColumn Header="Limit (GB)" Binding="{Binding LimitGB}" Width="100" />
                <DataGridComboBoxColumn x:Name="ActionColumn" Header="Then" SelectedItemBinding="{Binding Action}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
